<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.gov.go.saude.hubsaude</groupId>
        <artifactId>hubsaude-parent</artifactId>
        <version>0.1.3-SNAPSHOT</version>
        <relativePath />
    </parent>

    <artifactId>hubsaude-cliente-cli</artifactId>
    <version>0.1.3-SNAPSHOT</version>
    <name>HubSaúde Cliente CLI</name>
    <description>Ferramenta de linha de comando para verificação de acesso ao HubSaúde (pós-credenciamento), utilizando a biblioteca hubsaude-cliente-java.</description>
    <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude</url>

    <developers>
        <developer>
            <name>Daniel Nogueira da Costa</name>
            <url>https://github.com/nogueiralegacy</url>
        </developer>
        <developer>
            <name>Fábio Nogueira de Lucena</name>
            <url>https://github.com/kyriosdata</url>
        </developer>
    </developers>

    <dependencies>
        <!-- Biblioteca cliente: contém SmartTokenClient e demais classes -->
        <dependency>
            <groupId>br.gov.go.saude.hubsaude</groupId>
            <artifactId>hubsaude-cliente-java</artifactId>
            <version>0.1.3-SNAPSHOT</version>
        </dependency>

        <!-- SLF4J Simple: implementação minimalista para CLI -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JaCoCo: CLI interativo, não testável automaticamente -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/cli/VerificarAcesso.class</exclude>
                        <exclude>**/cli/VerificarAcesso$Config.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <!--
                        CLI interativo, não testável automaticamente:
                        desativa a verificação de cobertura (jacoco:check)
                        ligando-a à fase 'none'. Não basta usar <skip>true</skip>
                        porque o parâmetro obrigatório 'rules' do goal 'check'
                        é validado pelo Maven antes do execute().
                    -->
                    <execution>
                        <id>jacoco-check</id>
                        <phase>none</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Cria fat JAR executável (artefato principal, sem classifier) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>br.gov.go.saude.hubsaude.client.cli.VerificarAcesso</mainClass>
                                </transformer>
                                <!-- Merge service files (necessário para BouncyCastle) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
