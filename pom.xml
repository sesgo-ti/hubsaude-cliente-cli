<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.gov.go.saude.hubsaude</groupId>
        <artifactId>hubsaude-parent</artifactId>
        <version>0.4.49</version>
        <relativePath />
    </parent>

    <artifactId>hubsaude-cliente-cli</artifactId>
    <version>${revision}</version>

    <properties>
        <revision>0.3.21-SNAPSHOT</revision>
    </properties>

    <name>HubSaúde Cliente CLI</name>
    <description>Ferramenta de linha de comando para verificação de acesso ao 
        HubSaúde (pós-credenciamento), 
        utilizando a biblioteca hubsaude-cliente-java.</description>
    <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude</url>

    <organization>
        <name>SES-GO e UFG/INF</name>
        <url>https://www.saude.go.gov.br</url>
    </organization>

    <licenses>
        <license>
            <name>Licença Proprietária SES-GO / UFG</name>
            <url>https://github.com/FabricaDeSoftwareINF/server-hubsaude/blob/main/LICENSE</url>
            <distribution>manual</distribution>
            <comments>Consulte o arquivo LICENSE na raiz do repositório.</comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Daniel Nogueira da Costa</name>
            <url>https://github.com/nogueiralegacy</url>
        </developer>
        <developer>
            <name>Fábio Nogueira de Lucena</name>
            <url>https://github.com/kyriosdata</url>
        </developer>
    </developers>

    <dependencies>
        <!-- Biblioteca cliente: contém SmartTokenClient e demais classes
             (hubContext()/RS384, issue #361), resolvida do GitHub Packages. -->
        <dependency>
            <groupId>br.gov.go.saude.hubsaude</groupId>
            <artifactId>hubsaude-cliente-java</artifactId>
            <version>0.3.17</version>
        </dependency>

        <!-- SLF4J Simple: implementação minimalista para CLI -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>

        <!-- Testes -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JaCoCo (issue #986): verificação de cobertura reativada.
                As lógicas puras do CLI (parsing de argumentos, redação de
                segredos, validação de arquivos, formatação de payload JWT
                e rotinas de exibição no terminal) são cobertas por testes
                unitários. Apenas main (System.exit), a chamada de rede via
                SmartTokenClient e a leitura interativa de senha permanecem
                fora do alcance dos testes unitários. O mínimo de 0.70
                espelha o gate central COVERAGE_LINE (hubsaude-quality).
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Cria fat JAR executável (artefato principal, sem classifier) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <!--
                                spring-boot-configuration-processor é
                                herdado de hubsaude-parent como annotation
                                processor (gera metadados de @ConfigurationProperties
                                para IDEs). O cliente-cli não é Spring Boot
                                e não consome esse jar em runtime; excluído
                                do uber-jar para evitar ~200KB de classes
                                inúteis e múltiplos overlaps de recursos.
                            -->
                            <artifactSet>
                                <excludes>
                                    <exclude>org.springframework.boot:spring-boot-configuration-processor</exclude>
                                </excludes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>br.gov.go.saude.hubsaude.client.cli.VerificarAcesso</mainClass>
                                </transformer>
                                <!-- Merge service files (necessário para BouncyCastle) -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!--
                                    Mescla os arquivos de atribuição duplicados
                                    (META-INF/LICENSE[.txt] e META-INF/NOTICE) de
                                    SLF4J/Jackson/BouncyCastle em um único recurso,
                                    eliminando os WARNINGs de "overlapping resource"
                                    sem perder a atribuição de licenças.
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Assinaturas de jars (inválidas no uber-jar) -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!--
                                            module-info.class dos jars multi-release
                                            (BouncyCastle, SLF4J): o uber-jar roda no
                                            classpath, não como módulo JPMS. Remove os
                                            WARNINGs "Discovered module-info.class" e o
                                            overlap de META-INF/versions/9/module-info.
                                        -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!--
                                            MANIFEST.MF de entrada: o ManifestResourceTransformer
                                            gera o manifesto final; descartar os de origem
                                            elimina o overlap de META-INF/MANIFEST.MF.
                                        -->
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <!-- Metadados OSGi não usados pela CLI -->
                                        <exclude>META-INF/versions/*/OSGI-INF/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
